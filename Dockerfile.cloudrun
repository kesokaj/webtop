FROM ubuntu:24.04
LABEL org.opencontainers.image.source https://github.com/kesokaj/webtop

ENV DEBIAN_FRONTEND=noninteractive

# Core system + KDE desktop + base VNC deps
# --no-install-recommends avoids pulling apport-core-dump-handler which fails under QEMU
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl sudo gnupg ca-certificates software-properties-common \
        tigervnc-standalone-server xauth tigervnc-common novnc dbus-x11 \
        dbus-user-session fuse-overlayfs rsyslog iptables kmod uidmap \
        kde-plasma-desktop plasma-nm sddm konsole kwin-x11 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# KasmVNC — replaces TigerVNC + noVNC with WebP-encoded streaming (2-4x faster)
RUN curl -fsSL -o /tmp/kasmvnc.deb https://github.com/kasmtech/KasmVNC/releases/download/v1.5.0/kasmvncserver_noble_1.5.0_amd64.deb && \
    (dpkg -i /tmp/kasmvnc.deb || true) && \
    apt-get update && apt-get -f install -y && \
    rm /tmp/kasmvnc.deb && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Networking / troubleshooting tools
RUN apt-get update && \
    apt-get install -y \
        iputils-ping traceroute mtr-tiny dnsutils net-tools tcpdump nmap \
        htop jq vim less tmux wget strace lsof procps iproute2 \
        bash-completion openssh-client python3 python3-pip npm git nano && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# kubectl (direct binary — apt version crashes under QEMU during build)
RUN curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" && \
    chmod +x /usr/local/bin/kubectl

# gcloud CLI
RUN curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
      | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
      > /etc/apt/sources.list.d/google-cloud-sdk.list && \
    apt-get update && apt-get install -y google-cloud-cli google-cloud-cli-gke-gcloud-auth-plugin && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Terraform + OpenTofu
RUN curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com noble main" \
      > /etc/apt/sources.list.d/hashicorp.list && \
    apt-get update && apt-get install -y terraform && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://get.opentofu.org/install-opentofu.sh -o /tmp/install-opentofu.sh && \
    chmod +x /tmp/install-opentofu.sh && \
    /tmp/install-opentofu.sh --install-method deb && \
    rm /tmp/install-opentofu.sh

# Helm
RUN curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

# Go (latest stable)
RUN curl -fsSL https://go.dev/dl/go1.23.1.linux-amd64.tar.gz -o /tmp/go.tar.gz && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && rm /tmp/go.tar.gz && \
    echo 'export PATH=/usr/local/go/bin:$PATH' > /etc/profile.d/go.sh && \
    chmod +x /etc/profile.d/go.sh
ENV PATH="/usr/local/go/bin:${PATH}"

# Docker CLI (client only — no daemon in Cloud Run)
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu noble stable" \
      > /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y docker-ce-cli && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# GitHub CLI (direct binary)
RUN GH_VERSION=$(curl -fsSL https://api.github.com/repos/cli/cli/releases/latest | grep '"tag_name"' | sed 's/.*"v\(.*\)".*/\1/') && \
    curl -fsSL -o /tmp/gh.tar.gz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" && \
    tar -xzf /tmp/gh.tar.gz -C /tmp && \
    cp /tmp/gh_${GH_VERSION}_linux_amd64/bin/gh /usr/local/bin/gh && \
    rm -rf /tmp/gh* 

# Google Chrome
RUN curl -fsSL -o /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb && \
    (dpkg -i /tmp/chrome.deb || true) && \
    apt-get update && apt-get -f install -y && \
    rm /tmp/chrome.deb && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# VS Code
RUN curl -fsSL -L -o /tmp/code.deb "https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64" && \
    (dpkg -i /tmp/code.deb || true) && \
    apt-get update && apt-get -f install -y && \
    rm /tmp/code.deb && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Antigravity 2.0 desktop app
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://us-central1-apt.pkg.dev/doc/repo-signing-key.gpg \
      | gpg --dearmor --yes -o /etc/apt/keyrings/antigravity-repo-key.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/antigravity-repo-key.gpg] https://us-central1-apt.pkg.dev/projects/antigravity-auto-updater-dev/ antigravity-debian main" \
      > /etc/apt/sources.list.d/antigravity.list && \
    apt-get update && \
    apt-get install -y antigravity && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Antigravity CLI (agy)
RUN curl -fsSL https://antigravity.google/cli/install.sh | HOME=/root bash && \
    cp /root/.local/bin/agy /usr/local/bin/agy 2>/dev/null || true

# Disable PAM limits (Cloud Run has no CAP_SYS_RESOURCE)
RUN sed -i 's/^session.*pam_limits.so/#&/' /etc/pam.d/su /etc/pam.d/su-l 2>/dev/null || true

# Cloud Run init script
COPY init-cloudrun.sh /init-cloudrun.sh
RUN chmod +x /init-cloudrun.sh

EXPOSE 8080
ENV DISPLAY=:1
ENV SHELL_USER=user
ENV SHELL_PASSWORD=user
ENV PORT=8080
ENV TZ=UTC

ENTRYPOINT ["/init-cloudrun.sh"]
